# Copy this file to backend/.env and fill in the values.
# cp .env.example .env

# ── App ──────────────────────────────────────────────
APP_NAME=Sentivoy
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
# Browser origin allowed by CORS, plus localhost:5173 and localhost:8080.
FRONTEND_URL=http://localhost:5173

# ── Supabase ─────────────────────────────────────────
# Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role key. The API uses this for table access and Auth admin lookups.
# Never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Project Settings → API → JWT Secret (legacy HS256 projects).
# If local verification fails, the API falls back to Supabase Auth get_user.
SUPABASE_JWT_SECRET=your-jwt-secret

# ── Log ingestion ────────────────────────────────────
# Development key accepted by POST /api/logs. It attaches events to the
# first user in Supabase Auth. Create real keys from the dashboard instead.
API_KEY=sentivoy-dev-api-key-change-me

# ── Detection ────────────────────────────────────────
# Optional override of the trained reconstruction threshold in
# app/ml/model_store/calibration.json. Leave unset to use that file.
# ANOMALY_THRESHOLD=0.05
# Stored for configuration. The limiter in app/core/rate_limiter.py is 60/minute.
RATE_LIMIT=60

# ── Email (Resend) ───────────────────────────────────
# Optional. Alerts and report email are skipped when this is empty.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
ALERT_EMAIL_ENABLED=true
