# Copy this file to frontend/.env and fill in the values.
# copy .env.example .env

# FastAPI base URL. Defaults to http://localhost:8000 when unset.
VITE_API_URL=http://localhost:8000

# Supabase project URL and the anon (public) key.
# Project Settings → API. Do not put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
